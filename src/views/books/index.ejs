<%- include('../partials/header') %>

<h1>Bookshelf</h1>

<div class="search-container">
  <input 
    type="text" 
    name="q"
    id="search-input"
    placeholder="Search books by title or author..."
    hx-get="/books/search"
    hx-trigger="input changed delay:300ms"
    hx-target="#search-results"
    hx-indicator=".htmx-indicator"
  >
  <span class="htmx-indicator">Searching...</span>
</div>

<div id="search-results">
  <div class="book-grid">
    <% books.forEach(book => { %>
      <div class="book-card">
        <h2><a href="/books/<%= book.id %>"><%= book.title %></a></h2>
        <p class="author">by <%= book.author %></p>
        <% if (book.published_year) { %>
          <p class="year"><%= book.published_year %></p>
        <% } %>
      </div>
    <% }) %>
  </div>
</div>

<script>
  // HTMX doesn't swap 4xx responses by default; show the search validation error (400) in the results area.
  document.body.addEventListener('htmx:beforeSwap', function (evt) {
    if (evt.detail.xhr.status === 400 && evt.detail.target && evt.detail.target.id === 'search-results') {
      evt.detail.shouldSwap = true;
      evt.detail.isError = false;
    }
  });
</script>

<%- include('../partials/footer') %>
